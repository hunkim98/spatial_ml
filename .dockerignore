# Ignore temporary files and downloaded data
collector/tmp/
collector/.venv/
collector/__pycache__/
collector/**/__pycache__/
collector/**/*.pyc

# Ignore model directories
model/
model_dashboard/

# Ignore workflow build outputs
workflow/pipeline_outputs/
workflow/.venv/
workflow/__pycache__/
