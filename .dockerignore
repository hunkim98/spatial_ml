# Ignore Python artifacts
*.pyc
*.pyo
*.egg-info/
__pycache__/
.venv/
venv/
*.so

# Ignore data directories
data/
tmp/
wandb/

# Ignore IDE and OS files
.DS_Store
.vscode/
.idea/
*.swp
.git/
.dvc/

# Ignore secrets
secrets/
*.json
*.env
