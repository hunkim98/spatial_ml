# Infrastructure Configuration (local .env - NOT committed)
# Copy this file to .env and fill in your values

# ==============================================================================
# Google Cloud Platform
# ==============================================================================

# GCP Project ID
GCP_PROJECT=your-project-id

# GCS Buckets (you have TWO different buckets)
# 1. Data bucket: Contains zoneomics CSVs + municode ordinances (SOURCE DATA)
GCS_DATA_BUCKET=spatially-data

# 2. Model bucket: For storing trained models (OUTPUT)
GCS_MODEL_BUCKET=spatially-models

# Path to GCP service account key JSON file
# Alternative: Set GOOGLE_APPLICATION_CREDENTIALS environment variable system-wide
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Enable model upload to GCS after training (1=enabled, 0=disabled)
UPLOAD_TO_GCS=0

# Enable model dashboard to download models from GCS (1=enabled, 0=disabled)
# Set to 1 when running dashboard locally but using models trained in the cloud
USE_GCS_MODELS=0

# ==============================================================================
# Weights & Biases (W&B)
# ==============================================================================

# W&B API key for experiment tracking
WANDB_API_KEY=your-wandb-api-key

# W&B project name
WANDB_PROJECT=zoning-code-extraction

# W&B entity/team name
WANDB_ENTITY=your-wandb-entity

# ==============================================================================
# Notes
# ==============================================================================

# This file contains infrastructure credentials and should NEVER be committed.
# The actual .env file should be added to .gitignore.
#
# For training hyperparameters, see:
#   - training/.env.training.local  (local development, small batch size)
#   - training/.env.training.cloud  (GCP T4 GPU, large batch size)
#   - training/.env.training        (default config)
#
# This infrastructure config (.env) is the SAME for both local and cloud.
# Only the training config changes based on hardware.
