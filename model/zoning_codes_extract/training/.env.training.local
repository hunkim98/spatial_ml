# Training Configuration - LOCAL (CPU/Small GPU)
# Optimized for local development and testing on limited hardware

# ==============================================================================
# Model Configuration
# ==============================================================================

MODEL_NAME=bert-base-uncased
SEED=42
MAX_SEQ_LENGTH=512

# ==============================================================================
# Training Hyperparameters - LOCAL OPTIMIZED
# ==============================================================================

# Fewer epochs for faster iteration during development
NUM_EPOCHS=3

# Minimal batch size for MPS/limited memory
BATCH_SIZE=1

# Higher gradient accumulation to maintain effective batch size
# Effective batch size = 1 × 16 = 16
GRADIENT_ACCUMULATION_STEPS=16

LEARNING_RATE=3e-5
WEIGHT_DECAY=0.01
WARMUP_STEPS=50
LOGGING_STEPS=20

# ==============================================================================
# Model-Specific Configuration
# ==============================================================================

EXTRACTOR_METRIC=recall
VALIDATOR_METRIC=f1
VALIDATOR_NEG_POS_RATIO=1.0

# ==============================================================================
# Data Configuration
# ==============================================================================

TRAIN_RATIO=0.85
TEST_RATIO=0.15

CONTEXT_WINDOW=500
MAX_PASSAGES_PER_CODE=10
MIN_PASSAGES_PER_CODE=2

# ==============================================================================
# Advanced Training - LOCAL SETTINGS
# ==============================================================================

# Enable gradient checkpointing to reduce memory usage
GRADIENT_CHECKPOINTING=1

# No mixed precision (safer for CPU/MPS)
PRECISION=none

# Single-process loading for local
DATALOADER_WORKERS=0
PIN_MEMORY=0

# ==============================================================================
# Evaluation Configuration
# ==============================================================================

EVAL_STRATEGY=epoch
SAVE_STRATEGY=epoch
LOAD_BEST_MODEL=1

# ==============================================================================
# Custom Tokenization (Extractor Only)
# ==============================================================================

USE_CUSTOM_TOKENIZATION=1
USE_ENHANCED_TAGS=0

# ==============================================================================
# Inference Parameters
# ==============================================================================

MIN_EXTRACTION_SCORE=0.5
MIN_VALIDATION_CONFIDENCE=0.5
EXTRACTOR_OVERLAP=128
VALIDATOR_MAX_PASSAGES=5

# ==============================================================================
# Notes
# ==============================================================================

# This configuration is optimized for:
# - Local development on CPU or small GPU (MPS/laptop GPU)
# - Fast iteration and testing
# - Limited memory environments
#
# Effective Batch Size: 2 × 8 = 16
# Use --states flag to limit which states to train on for faster iteration
# Expected Training Time: Depends on number of states/cities
