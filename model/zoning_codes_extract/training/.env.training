# Training Hyperparameters Configuration
# This file contains all configurable hyperparameters for the training pipeline.
# Modify these values to experiment with different training configurations.

# ==============================================================================
# Model Configuration
# ==============================================================================

# Base model to fine-tune (HuggingFace model name)
MODEL_NAME=bert-base-uncased

# Random seed for reproducibility
SEED=42

# Maximum sequence length (tokens)
MAX_SEQ_LENGTH=512

# ==============================================================================
# Training Hyperparameters (applies to both extractor and validator)
# ==============================================================================

# Number of training epochs
NUM_EPOCHS=3

# Batch size per device
BATCH_SIZE=2

# Gradient accumulation steps (effective batch size = BATCH_SIZE * GRADIENT_ACCUMULATION_STEPS)
GRADIENT_ACCUMULATION_STEPS=8

# Learning rate
LEARNING_RATE=3e-5

# Weight decay for regularization
WEIGHT_DECAY=0.01

# Number of warmup steps for learning rate scheduler
WARMUP_STEPS=50

# Logging frequency (log metrics every N steps)
LOGGING_STEPS=20

# ==============================================================================
# Model-Specific Configuration
# ==============================================================================

# Extractor: Metric to use for selecting best model
EXTRACTOR_METRIC=recall

# Validator: Metric to use for selecting best model
VALIDATOR_METRIC=f1

# Validator: Ratio of negative to positive examples during data preparation
VALIDATOR_NEG_POS_RATIO=1.0

# ==============================================================================
# Data Preparation Configuration
# ==============================================================================

# Train/test split ratios (should sum to 1.0)
TRAIN_RATIO=0.85
TEST_RATIO=0.15

# Context window size (characters) for extracting zone code mentions
CONTEXT_WINDOW=500

# Maximum passages per zone code in validator data
MAX_PASSAGES_PER_CODE=10

# Minimum passages required to include a zone code
MIN_PASSAGES_PER_CODE=2

# ==============================================================================
# Advanced Training Configuration
# ==============================================================================

# Enable/disable gradient checkpointing (1=enabled, 0=disabled)
# Gradient checkpointing reduces memory usage but increases training time
GRADIENT_CHECKPOINTING=1

# Mixed precision training (none, fp16, or bf16)
# Note: fp16 may not work on all hardware (e.g., Apple MPS)
PRECISION=none

# Number of dataloader workers (0 = load in main process)
DATALOADER_WORKERS=0

# Pin memory for dataloader (1=enabled, 0=disabled)
# Can speed up data transfer to GPU
PIN_MEMORY=0

# ==============================================================================
# Evaluation Configuration
# ==============================================================================

# Evaluation strategy (epoch or steps)
EVAL_STRATEGY=epoch

# Save strategy (epoch or steps)
SAVE_STRATEGY=epoch

# Load best model at end of training (1=enabled, 0=disabled)
LOAD_BEST_MODEL=1

# ==============================================================================
# Custom Tokenization (Extractor Only)
# ==============================================================================

# Enable custom zone-aware tokenization (1=enabled, 0=disabled)
USE_CUSTOM_TOKENIZATION=1

# Use enhanced BIO tags with token types (1=enabled, 0=disabled)
USE_ENHANCED_TAGS=0

# ==============================================================================
# Inference Parameters
# ==============================================================================

# Minimum confidence threshold for extractor predictions
MIN_EXTRACTION_SCORE=0.5

# Minimum confidence threshold for validator predictions
MIN_VALIDATION_CONFIDENCE=0.5

# Overlap size for extractor sliding window (tokens)
EXTRACTOR_OVERLAP=128

# Maximum number of passages to send to validator per zone code
VALIDATOR_MAX_PASSAGES=5

# ==============================================================================
# Notes
# ==============================================================================

# Effective Batch Size Calculation:
#   Effective Batch Size = BATCH_SIZE × GRADIENT_ACCUMULATION_STEPS
#   Example: 2 × 8 = 16
#
# Memory vs Speed Trade-offs:
#   - Increase BATCH_SIZE: More memory, faster training
#   - Increase GRADIENT_ACCUMULATION_STEPS: Same memory, slower but better gradients
#   - Enable GRADIENT_CHECKPOINTING: Less memory, slower training
#
# Learning Rate Guidelines:
#   - BERT base: 2e-5 to 5e-5
#   - Larger models: 1e-5 to 3e-5
#   - Smaller datasets: Lower learning rates
#
# Recommended Starting Points:
#   - Quick testing: NUM_EPOCHS=1, N_CITIES=10
#   - Development: NUM_EPOCHS=3, N_CITIES=50
#   - Production: NUM_EPOCHS=5, N_CITIES=163
