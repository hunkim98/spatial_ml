# Training Configuration - CLOUD (GCP T4 GPU)
# Optimized for production training on GCP VM with T4 GPU

# ==============================================================================
# Model Configuration
# ==============================================================================

MODEL_NAME=bert-base-uncased
SEED=42
MAX_SEQ_LENGTH=512

# ==============================================================================
# Training Hyperparameters - CLOUD OPTIMIZED
# ==============================================================================

# More epochs for better model quality
NUM_EPOCHS=5

# Larger batch size for T4 GPU (16GB memory)
BATCH_SIZE=8

# Lower gradient accumulation since batch size is larger
# Effective batch size = 8 × 4 = 32
GRADIENT_ACCUMULATION_STEPS=4

LEARNING_RATE=3e-5
WEIGHT_DECAY=0.01
WARMUP_STEPS=100
LOGGING_STEPS=20

# ==============================================================================
# Model-Specific Configuration
# ==============================================================================

EXTRACTOR_METRIC=recall
VALIDATOR_METRIC=f1
VALIDATOR_NEG_POS_RATIO=1.0

# ==============================================================================
# Data Configuration
# ==============================================================================

TRAIN_RATIO=0.85
TEST_RATIO=0.15

CONTEXT_WINDOW=500
MAX_PASSAGES_PER_CODE=10
MIN_PASSAGES_PER_CODE=2

# ==============================================================================
# Advanced Training - CLOUD SETTINGS
# ==============================================================================

# Enable gradient checkpointing for memory efficiency
GRADIENT_CHECKPOINTING=1

# Use fp16 mixed precision for faster training on T4
PRECISION=fp16

# Use multiple workers for faster data loading
DATALOADER_WORKERS=4
PIN_MEMORY=1

# ==============================================================================
# Evaluation Configuration
# ==============================================================================

EVAL_STRATEGY=epoch
SAVE_STRATEGY=epoch
LOAD_BEST_MODEL=1

# ==============================================================================
# Custom Tokenization (Extractor Only)
# ==============================================================================

USE_CUSTOM_TOKENIZATION=1
USE_ENHANCED_TAGS=0

# ==============================================================================
# Inference Parameters
# ==============================================================================

MIN_EXTRACTION_SCORE=0.5
MIN_VALIDATION_CONFIDENCE=0.5
EXTRACTOR_OVERLAP=128
VALIDATOR_MAX_PASSAGES=5

# ==============================================================================
# Notes
# ==============================================================================

# This configuration is optimized for:
# - GCP VM with T4 GPU (16GB VRAM)
# - Production-quality model training
# - Full dataset (all cities from specified states)
#
# Effective Batch Size: 8 × 4 = 32
# Use --states flag to specify which states to train on (or omit for all states)
# Expected Training Time: ~3-4 hours per model on T4 GPU (full dataset)
#
# T4 GPU Specifications:
# - 16GB GDDR6 memory
# - 8.1 TFLOPS FP32
# - 65 TFLOPS FP16 (Tensor Cores)
# - 320 GB/s memory bandwidth
